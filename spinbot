-- Input Handling
local dragging = nil
local dragStart = nil
local startPos = nil
local knobStartPos = nil
local lastMouse1 = false

local active = false
local character = game.Players.LocalPlayer.Character
local part = character:WaitForChild("HumanoidRootPart")

local function spin()
	while true do
	task.wait()
		angle = 0
		local speed = Slider11_Value
		for i = 0, 36  do
			
			task.wait(0.05)
			part.CFrame = CFrame.new(part.Position.X, part.Position.Y, part.Position.Z)
			* CFrame.Angles(0, math.rad(angle + speed), 0)
			local look = part.CFrame.LookVector
			local yaw = math.deg(math.atan2(look.X, look.Z))
			angle = yaw
			if angle > 360 then
				angle = 0
			end
		end
	end
end

local function toggled()
	print("Activated")
	if active == false then
		active = true
		spin()
	else
		active = false
	end
end


while true do
    wait(0.01)
    if isrbxactive() then
        local mouse1 = ismouse1pressed()
        local mPos = Vector2.new(Mouse.X, Mouse.Y)

        -- Mouse Down (Just Pressed)
        if mouse1 and not lastMouse1 then
            -- Button Button12
            if Button12.Visible and mPos.X >= Button12.Position.X and mPos.X <= Button12.Position.X + Button12.Size.X and
               mPos.Y >= Button12.Position.Y and mPos.Y <= Button12.Position.Y + Button12.Size.Y then
                pcall(function() onClick() end)
				print("Click!")
				toggled()
            end
            -- Drag Square10
            if Square10.Visible and mPos.X >= Square10.Position.X and mPos.X <= Square10.Position.X + Square10.Size.X and
               mPos.Y >= Square10.Position.Y and mPos.Y <= Square10.Position.Y + Square10.Size.Y then
                dragging = Square10
                dragStart = mPos
                startPos = Square10.Position
            end
            -- Drag Slider11
            if Slider11_Knob.Visible and mPos.X >= Slider11_Knob.Position.X and mPos.X <= Slider11_Knob.Position.X + Slider11_Knob.Size.X and
               mPos.Y >= Slider11_Knob.Position.Y and mPos.Y <= Slider11_Knob.Position.Y + Slider11_Knob.Size.Y then
                dragging = Slider11_Knob
                dragStart = mPos
                startPos = Slider11_Knob.Position
            end
        end

        -- Mouse Up (Just Released)
        if not mouse1 and lastMouse1 then
            dragging = nil
        end

        -- Dragging Update
        if dragging and mouse1 then
            local delta = mPos - dragStart
            dragging.Position = startPos + delta
            if dragging == Slider11_Knob then
                -- Constrain to track
                local minX = Slider11.Position.X
                local maxX = Slider11.Position.X + Slider11.Size.X
                if dragging.Position.X < minX then dragging.Position = Vector2.new(minX, dragging.Position.Y) end
                if dragging.Position.X > maxX then dragging.Position = Vector2.new(maxX, dragging.Position.Y) end
                dragging.Position = Vector2.new(dragging.Position.X, Slider11.Position.Y + 5 - dragging.Size.Y/2)
                -- Calculate Value
                local percent = (dragging.Position.X - minX) / (Slider11.Size.X)
                local value = 0 + (30 - 0) * percent
                Slider11_Value = value
                Slider11_ValueText.Text = tostring(math.floor(value)) .. ""
                pcall(function() onChanged(value) end)
            end
            if dragging == Square10 then
                Spinbottt.Position = dragging.Position + Vector2.new(19, 15)
                Slider11.Position = dragging.Position + Vector2.new(14, 83)
                local percent = (Slider11_Value - 0) / (30 - 0)
                Slider11_Knob.Position = Slider11.Position + Vector2.new(78 * percent - 10, 5 - 10)
                Slider11_ValueText.Position = Slider11.Position + Vector2.new(78/2, -10)
                Button12.Position = dragging.Position + Vector2.new(19, 110)
                Button12_Text.Position = Button12.Position + Vector2.new(68/2, 15/2)
                Text13.Position = dragging.Position + Vector2.new(35, 48)
            end
        end

        lastMouse1 = mouse1
    end
end
